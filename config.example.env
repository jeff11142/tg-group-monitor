# ===== Telegram API 憑證 =====
# 到 https://my.telegram.org → API development tools 申請，會拿到這兩個值
API_ID=
API_HASH=

# 第一次登入用的手機號碼（含國碼，例如 +886912345678）
PHONE=

# session 檔名稱（登入後會產生 <SESSION_NAME>.session，之後不用再輸入驗證碼）
SESSION_NAME=tg_monitor

# ===== 要監聽的來源群組 =====
# 可填：群組的 @username、邀請連結後綴、或數字 ID（例如 -1001234567890）
# 不確定 ID 時，先把 LIST_DIALOGS=1 跑一次，會印出你所有對話的名稱與 ID
SOURCE_CHAT=

# ===== 關鍵字過濾（逗號分隔，不分大小寫）=====
# 訊息內容只要「包含任一關鍵字」就會被記錄與轉發；留空＝全部訊息都轉發
KEYWORDS=

# ===== 轉發目標：用 Bot 廣播給「接收者清單」=====
# 1. 到 TG 找 @BotFather → /newbot 取得 token，填這裡
# 2. 對你的 bot 按一次 /start（bot 才能私訊你），再把你的 chat_id 填到 BOT_TARGET
#    （取得 chat_id：找 @userinfobot 查你的數字 ID）
# 3. ADMIN_CHAT_ID 是「能對 bot 下管理指令的人」，通常就是你自己 (= BOT_TARGET)
#    指令清單：/list /add /remove /enable /disable /myid /help
# 4. BOT_TARGET 只在第一次跑時被用來自動建立接收者清單的第一筆；之後 DB 是 source of truth，
#    要新增/移除接收者請對 bot 用 /add /remove 指令（資料存在 recipients.db）
BOT_TOKEN=
BOT_TARGET=
ADMIN_CHAT_ID=

# ===== 轉發目標 2：Webhook / Discord / 自己後台 =====
# 任何接收 JSON POST 的 URL；Discord webhook 也支援。留空＝不發 webhook
WEBHOOK_URL=

# ===== 本機記錄 =====
# 是否把命中的訊息同時寫入本機檔案（JSON Lines）
LOG_TO_FILE=1
LOG_FILE=messages.jsonl

# 只列出對話清單後結束（找 SOURCE_CHAT 的 ID 用），設 1 啟用
LIST_DIALOGS=0

# ===== 幣安現貨自動交易（依訊號自動下單）=====
# 總開關：1 才會自動下單；0＝只監聽轉發不交易
TRADING_ENABLED=0
# ⚠️ 強烈建議先用 testnet（測試網假錢）驗證：1=testnet，0=正式網（真錢）
# testnet 申請 API 金鑰：https://testnet.binance.vision/
BINANCE_TESTNET=1
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 每筆固定投入多少 USDT（限價進場用此金額換算數量）
TRADE_USDT=50
# 最多同時持有幾筆未結倉（上限保護，避免訊號爆量時無限下單）
MAX_OPEN_TRADES=5
# 四個目標價的分批平倉比例（逗號分隔，會自動正規化）；目標數不足會自動截斷
TP_RATIOS=30,30,20,20
# 止損腿（stop-limit）的限價，設在觸發價下方多少 %，確保急殺時掛得掉
SL_LIMIT_BUFFER_PCT=0.3
# 賣單預留手續費緩衝（%）：拆單時從買進量扣掉，避免賣超實得數量
SELL_FEE_BUFFER_PCT=0.1
# 限價買單未成交時，輪詢檢查的間隔秒數
ENTRY_POLL_INTERVAL=5
# 對帳/收單迴圈的檢查間隔（秒）：交易全平後自動標記 CLOSED 釋放持倉額度
TRADE_MONITOR_INTERVAL=15
# 第一個止盈成交後，是否把剩餘止損移到保本（進場價）。1=開 0=關
BREAKEVEN_AFTER_TP1=1
# 限價買單超過幾分鐘未成交就撤單、釋放持倉額度（0=永不超時，一直等成交）
# 部分成交才超時的話，會保護已成交部分、只撤掉未成交的剩餘
ENTRY_TIMEOUT_MIN=30
