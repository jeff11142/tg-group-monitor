[Unit]
Description=Telegram 群組關鍵字監聽轉發
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你 VPS 上實際的使用者與路徑（使用者不存在會 status=217/USER 起不來）
User=root
# 讓 Python print 即時寫進 journal（否則輸出會被緩衝、journalctl 看不到）
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tg-group-monitor
ExecStart=/opt/tg-group-monitor/.venv/bin/python /opt/tg-group-monitor/main.py
Restart=always
RestartSec=10
# 拉高開檔上限：WS 重連風暴或突發流量時的保險，避免 [Errno 24] Too many open files 連鎖崩潰
LimitNOFILE=65536
# 斷線/錯誤自動重啟；連續失敗也不放棄
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
